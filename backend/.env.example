NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://vidlynk:vidlynk_secret@localhost:5432/vidlynk_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="vidlynk_ultra_secure_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="vidlynk-media"
R2_PUBLIC_DOMAIN="https://pub-yourdomain.r2.dev" # Or custom CDN domain e.g. https://cdn.vidlynk.app

# App Configuration
APP_DEEP_LINK_BASE_URL="https://vidlynk.app/watch"
